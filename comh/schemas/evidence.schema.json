{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence",
  "description": "Source-owned fact store. Extracted, citable units with provenance. Claims live in narrative.yaml, not here.",
  "type": "object",
  "required": [
    "version",
    "items"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SRC[0-9]{2,}$"
          },
          "path": {
            "type": "string",
            "description": "Path relative to the run root, e.g. sources/results.csv"
          },
          "kind": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "content",
          "source"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[0-9]{3,}$"
          },
          "kind": {
            "type": "string",
            "description": "Open vocabulary. Built-in kinds with validator semantics: datum, quote, table, figure, fact, assumption."
          },
          "content": {
            "type": "string",
            "description": "Human-readable summary of the fact."
          },
          "source": {
            "type": "object",
            "required": [
              "source",
              "locator"
            ],
            "additionalProperties": true,
            "properties": {
              "source": {
                "type": "string",
                "description": "Source ID (SRCxx) or 'derived' for computed values.",
                "pattern": "^(SRC[0-9]{2,}|derived)$"
              },
              "locator": {
                "type": "string",
                "description": "Where in the source, e.g. 'sheet=latency,row=12', 'p.4 para 2', or 'derived:(E001,E002)'.",
                "minLength": 1
              },
              "quote": {
                "type": "string"
              }
            }
          },
          "value": {
            "type": "object",
            "required": [
              "number",
              "unit"
            ],
            "additionalProperties": true,
            "properties": {
              "number": {
                "type": "number",
                "description": "Machine-checkable numeric value; anchor for number-consistency checks."
              },
              "unit": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "description": "What the number measures, e.g. 'p99 latency reduction'."
              }
            }
          },
          "asset": {
            "type": "string",
            "description": "Path (relative to run root) of an extracted figure/table asset."
          },
          "extraction": {
            "type": "object",
            "description": "How this fact was obtained. Via 'visual' means read off an image/chart by a vision-capable model: such values are ESTIMATES, not ground truth. 'file' = read from data/text; 'derived' = computed from other items (also expressible via locator 'derived:(...)').",
            "additionalProperties": true,
            "properties": {
              "via": {
                "type": "string",
                "description": "file | visual | derived (open vocabulary)"
              },
              "confidence": {
                "type": "string",
                "description": "exact | estimated. Numbers read off chart pixels are 'estimated' unless corroborated by an underlying data file."
              },
              "note": {
                "type": "string"
              }
            }
          },
          "observed_at": {
            "type": "string",
            "description": "When the underlying measurement/observation was made. ISO 8601 preferred; MUST be a quoted string in YAML ('2026-08-28'), since unquoted dates parse as date objects and fail schema validation. Enables future freshness QA."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          },
          "derived": {
            "type": "object",
            "required": [
              "formula"
            ],
            "additionalProperties": true,
            "properties": {
              "formula": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "precision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 12
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "datum"
                }
              }
            },
            "then": {
              "required": [
                "value"
              ]
            }
          }
        ]
      }
    }
  }
}
